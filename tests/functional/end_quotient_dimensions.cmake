# Run with cmake -DDRIVER=/path/to/end_quotient_dimensions -P this_file.
if(NOT EXISTS "${DRIVER}")
    message(FATAL_ERROR "Set DRIVER to the built end_quotient_dimensions executable")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/quotient-dimension-fixtures")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/free.scc" "scc2020\n2\n0 2 0\n0 1 ;\n1 0 ;\n")
file(WRITE "${work}/relation.scc" "scc2020\n2\n1 2 0\n5 2 ; 0\n0 0 ;\n1 0 ;\n")
foreach(case "free,0,2,2,0" "free,50,2,4,2" "relation,0,3,3,0" "relation,50,3,1,0")
    string(REPLACE "," ";" fields "${case}")
    list(GET fields 0 name)
    list(GET fields 1 epsilon)
    list(GET fields 2 e)
    list(GET fields 3 h)
    list(GET fields 4 q)
    execute_process(COMMAND "${DRIVER}" "${work}/${name}.scc" "${epsilon}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 30)
    foreach(expected "End_0_dimension=${e}\n" "End_2e_dimension=${h}\n" "Q_dimension=${q}\n")
        string(FIND "${output}" "${expected}" found)
        if(NOT result EQUAL 0 OR found EQUAL -1)
            message(FATAL_ERROR "Failed ${name} at ${epsilon}%: ${output}\n${diagnostics}")
        endif()
    endforeach()
endforeach()
message(STATUS "Quotient dimensions: zero shift, nonzero quotient, and target-relation normalization passed")

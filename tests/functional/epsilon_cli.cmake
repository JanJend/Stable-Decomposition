function(check_success expected)
    execute_process(COMMAND "${PRUNING}" "${INPUT}" --no-output ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Pruning failed (${result}): ${output}\n${error}")
    endif()
    if(output MATCHES "shift=")
        message(FATAL_ERROR "Unexpected shift diagnostic: ${output}")
    endif()
    string(FIND "${output}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing expected output '${expected}': ${output}")
    endif()
endfunction()

# test1.scc has side lengths (4,4), hence epsilon=(0.04,0.04).
check_success("(epsilon=(0.04,0.04))")
check_success("(epsilon=(0.25,0.25))" --epsilon 0.25)
check_success("(epsilon=(0.25,0.25))" --delta 0.25)
check_success("(epsilon=(0,0))" --epsilon 0)
check_success("threads=1" --threads 1 --profile)
check_success("threads=3" --threads 3 --profile)
foreach(value IN ITEMS 0 -1 invalid 1.5)
    execute_process(COMMAND "${PRUNING}" "${INPUT}" --threads "${value}" --no-output
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 30)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "Invalid thread count '${value}' was not rejected cleanly: ${result}")
    endif()
endforeach()
foreach(value IN ITEMS -1 nan inf 1e308 invalid)
    execute_process(COMMAND "${PRUNING}" "${INPUT}" --epsilon "${value}" --no-output
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "Invalid epsilon '${value}' was not rejected cleanly: ${result}")
    endif()
endforeach()
execute_process(COMMAND "${PRUNING}" "${INPUT}" --epsilon
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "Missing epsilon value was not rejected cleanly: ${result}")
endif()

# Unequal side lengths: percent and explicit vector must agree in every CLI route.
set(work "${CMAKE_CURRENT_BINARY_DIR}/epsilon-vector-fixtures")
file(MAKE_DIRECTORY "${work}")
set(INPUT "${work}/rectangle.scc")
file(WRITE "${INPUT}" "scc2020\n2\n0 2 0\n0 0 ;\n100 10 ;\n")
check_success("(epsilon=(1,0.1))")
check_success("(epsilon=(2,0.2))" --epsilon-percent 2)
check_success("(epsilon=(1,0.1))" --epsilon-vector 1 0.1)
check_success("(epsilon=(1,0.1))" --epsilon-percent 1 --old)
check_success("Checks passed." --epsilon-vector 1 0.1 --compare -o "${work}/compare.scc")
execute_process(COMMAND "${PRUNING}" "${INPUT}" --epsilon-percent 1
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0 OR NOT EXISTS "${work}/rectangle_pru1.0000_0.1000.scc")
    message(FATAL_ERROR "Vector output filename failed: ${error}")
endif()
foreach(value IN ITEMS -1 nan inf 1e308 invalid)
    foreach(option IN ITEMS --epsilon-vector --epsilon-percent)
        set(values "${value}")
        if(option STREQUAL "--epsilon-vector")
            list(PREPEND values 0.1)
        endif()
        execute_process(COMMAND "${PRUNING}" "${INPUT}" ${option} ${values} --no-output
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 30)
        if(NOT result EQUAL 1)
            message(FATAL_ERROR "Invalid ${option} '${value}' was accepted: ${result}")
        endif()
    endforeach()
endforeach()
